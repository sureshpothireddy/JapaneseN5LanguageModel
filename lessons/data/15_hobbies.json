 "title": "Hobbies & Likes",
 "icon": "🎨",
 "level": "N5",
 "difficulty": 2,
 "description": "Say what you like and what you're good at with すき and じょうず.",
 "objectives": [
  "Use 〜が すきです (I like ~)",
  "Use 〜が じょうずです (good at ~)",
  "Talk about hobbies (しゅみ)"
 ],
 "study_guide": [
  {
   "heading": "〜が すきです",
   "body": "The thing you like takes が, not を: おんがくが すきです = I like music. すき is a な-adjective meaning 'liked'."
  },
  {
   "heading": "Degrees of liking",
   "body": "だいすき = love, すき = like, あまり すきじゃない = don't really like, きらい = dislike. スポーツが だいすきです = I love sports."
  },
  {
   "heading": "じょうず / へた",
   "body": "じょうず = good at, へた = bad at, both take が: りょうりが じょうずです = good at cooking."
  }
 ],
 "examples": [
  {
   "ja": "わたしは えいがが すきです。",
   "romaji": "watashi wa eiga ga suki desu",
   "en": "I like movies."
  },
  {
   "ja": "りょうりが じょうずですね。",
   "romaji": "ryouri ga jouzu desu ne",
   "en": "You're good at cooking!"
  },
  {
   "ja": "スポーツが だいすきです。",
   "romaji": "supootsu ga daisuki desu",
   "en": "I love sports."
  },
  {
   "ja": "しゅみは おんがくです。",
   "romaji": "shumi wa ongaku desu",
   "en": "My hobby is music."
  }
 ],
 "grammar_note": {
  "title": "が with feelings/skill",
  "body": "すき・きらい・じょうず・へた describe feeling/ability and mark their object with が, not を."
 },
 "culture_note": "Asking しゅみは なんですか (what's your hobby?) is a standard friendly ice-breaker, much like 'what do you do for fun?' in English.",
