 "study_guide": [
  {
   "heading": "The base numbers",
   "body": "いち,に,さん,し/よん,ご,ろく,しち/なな,はち,きゅう,じゅう. For 4 and 7, prefer よん and なな in daily life."
  },
  {
   "heading": "Bigger numbers",
   "body": "ひゃく = 100, せん = 1000. Combine: にひゃく = 200, さんぜん = 3000. Prices end in えん (yen)."
  },
  {
   "heading": "Asking how much",
   "body": "いくらですか = how much? これは いくらですか = How much is this? Answer with number + えんです."
  }
 ],
