  "Recognize the て-form of common verbs",
  "Make requests with 〜てください",
  "Link actions: 〜て、〜ます"
 ],
 "study_guide": [
  {
   "heading": "What the て-form does",
   "body": "The て-form is a connector. It builds requests (〜てください), ongoing actions (〜ています), permission, and links clauses. It's the gateway to intermediate Japanese."
  },
  {
   "heading": "〜てください = please do",
   "body": "みてください = please look, きいてください = please listen, まってください = please wait. Soft, polite, essential in class and travel."
  },
  {
   "heading": "Linking with て",
   "body": "おきて、ごはんを たべて、がっこうへ いきます = I get up, eat, and go to school. て chains actions in order."
  }
 ],
 "examples": [
  {
   "ja": "ちょっと まってください。",
   "romaji": "chotto matte kudasai",
   "en": "Please wait a moment."
  },
  {
   "ja": "ここに なまえを かいてください。",
   "romaji": "koko ni namae o kaite kudasai",
   "en": "Please write your name here."
  },
  {
   "ja": "もういちど いってください。",
   "romaji": "mou ichido itte kudasai",
   "en": "Please say it once more."
  },
  {
   "ja": "おきて、コーヒーを のみます。",
   "romaji": "okite, koohii o nomimasu",
   "en": "I get up and drink coffee."
  }
 ],
 "grammar_note": {
  "title": "て-form + ください",
  "body": "て-form + ください = polite request. て also links sequential actions and forms the basis of many grammar patterns to come."
 },
 "culture_note": "ちょっと まって ('wait a sec') softened with ください is everywhere. Adding ちょっと (a little) makes requests gentler and more natural.",
