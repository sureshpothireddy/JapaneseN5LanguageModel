 "title": "Past Tense (ました)",
 "icon": "⏪",
 "level": "N5",
 "difficulty": 3,
 "description": "Talk about yesterday: the polite past ました / ませんでした.",
 "objectives": [
  "Form polite past with ました",
  "Negative past ませんでした",
  "Use time words きのう, せんしゅう"
 ],
 "study_guide": [
  {
   "heading": "ます → ました",
   "body": "For polite past, swap ます for ました: たべます → たべました (ate). きのう すしを たべました = I ate sushi yesterday."
  },
  {
   "heading": "Negative past: ませんでした",
   "body": "たべます → たべませんでした (did not eat). きのう べんきょうしませんでした = I didn't study yesterday."
  },
  {
   "heading": "Time words",
   "body": "きのう (yesterday), せんしゅう (last week), せんげつ (last month), きょねん (last year) usually go near the start of the sentence."
  }
 ],
 "examples": [
  {
   "ja": "きのう えいがを みました。",
   "romaji": "kinou eiga o mimashita",
   "en": "I watched a movie yesterday."
  },
  {
   "ja": "せんしゅう きょうとへ いきました。",
   "romaji": "senshuu kyouto e ikimashita",
   "en": "I went to Kyoto last week."
  },
  {
   "ja": "あさごはんを たべませんでした。",
   "romaji": "asagohan o tabemasen deshita",
   "en": "I didn't eat breakfast."
  },
  {
   "ja": "テストは どうでしたか。",
   "romaji": "tesuto wa dou deshita ka",
   "en": "How was the test?"
  }
 ],
 "grammar_note": {
  "title": "ました / ませんでした",
  "body": "Past affirmative = stem + ました. Past negative = stem + ませんでした. です past = でした."
 },
 "culture_note": "おつかれさまでした ('you must be tired', i.e. good work) is said at the end of a workday or shared effort — a past-tense set phrase you'll hear daily.",
