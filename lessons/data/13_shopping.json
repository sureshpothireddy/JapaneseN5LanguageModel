 "description": "Buy things, ask prices, and use counters in a shop.",
 "objectives": [
  "Ask いくらですか and これを ください",
  "Use 〜を ください to request",
  "Recognize price/counter words"
 ],
 "study_guide": [
  {
   "heading": "〜を ください",
   "body": "これを ください = I'll take this / please give me this. Point + これ/それ + を ください is all you need to shop."
  },
  {
   "heading": "Asking the price",
   "body": "いくらですか = how much? ぜんぶで いくらですか = how much in total? Numbers + えん = yen: ごひゃくえん = 500 yen."
  },
  {
   "heading": "Counters preview",
   "body": "Japanese counts objects with counter words: ひとつ, ふたつ, みっつ (1,2,3 generic things). りんごを ふたつ ください = two apples please."
  }
 ],
 "examples": [
  {
   "ja": "これを ください。",
   "romaji": "kore o kudasai",
   "en": "I'll take this, please."
  },
  {
   "ja": "ぜんぶで いくらですか。",
   "romaji": "zenbu de ikura desu ka",
   "en": "How much altogether?"
  },
  {
   "ja": "みずを ふたつ ください。",
   "romaji": "mizu o futatsu kudasai",
   "en": "Two waters, please."
  },
  {
   "ja": "カードで おねがいします。",
   "romaji": "kaado de onegai shimasu",
   "en": "By card, please."
  }
 ],
 "grammar_note": {
  "title": "〜を ください / で",
  "body": "〜を ください requests an item. で marks the means (カードで = by card). Generic counters: ひとつ/ふたつ/みっつ…"
 },
 "culture_note": "Cash is still king in many Japanese shops, and you'll often place money on a small tray rather than into the cashier's hand. IC cards (Suica/Pasmo) are the easy modern option.",
