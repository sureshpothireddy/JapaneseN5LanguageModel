 "order": 9,
 "title": "Daily Verbs (ます form)",
 "icon": "🏃",
 "level": "N5",
 "difficulty": 2,
 "description": "Talk about what you do: eat, drink, go, see, using polite ます verbs.",
 "objectives": [
  "Use the polite ます verb form",
  "Build [object] を [verb] sentences",
  "Negate with ません"
 ],
 "study_guide": [
  {
   "heading": "The ます form is your safe default",
   "body": "Polite present verbs end in ます: たべます (eat), のみます (drink), いきます (go), みます (see/watch). Use ます forms everywhere as a beginner — they're always polite and always correct."
  },
  {
   "heading": "Negative = ません",
   "body": "Swap ます for ません to make it negative: たべます (I eat) → たべません (I don't eat). にくを たべません = I don't eat meat."
  },
  {
   "heading": "Word order: verb goes last",
   "body": "Japanese is Subject–Object–Verb. わたしは ごはんを たべます = I rice eat. The verb always comes at the very end of the sentence."
  }
 ],
 "examples": [
  {
   "ja": "まいにち コーヒーを のみます。",
   "romaji": "mainichi koohii o nomimasu",
   "en": "I drink coffee every day."
  },
  {
   "ja": "テレビを みます。",
   "romaji": "terebi o mimasu",
   "en": "I watch TV."
  },
  {
   "ja": "にくを たべません。",
   "romaji": "niku o tabemasen",
   "en": "I don't eat meat."
  },
  {
   "ja": "がっこうへ いきます。",
   "romaji": "gakkou e ikimasu",
   "en": "I go to school."
  }
 ],
 "grammar_note": {
  "title": "ます / ません",
  "body": "Polite verbs end in ます (affirmative) or ません (negative). The object takes を. Destination takes へ or に."
 },
 "culture_note": "Using ます forms shows respect and is expected with anyone you don't know well. Casual 'dictionary form' comes later — start polite and you'll never offend.",
