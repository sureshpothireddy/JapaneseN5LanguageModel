 "study_guide": [
  {
   "heading": "〜が いたいです",
   "body": "The hurting part takes が: あたまが いたいです = I have a headache. おなかが いたいです = my stomach hurts."
  },
  {
   "heading": "Feeling unwell",
   "body": "きぶんが わるいです = I feel sick. ねつが あります = I have a fever. かぜを ひきました = I caught a cold."
  },
  {
   "heading": "At the clinic",
   "body": "びょういん = hospital/clinic, くすり = medicine, いしゃ = doctor. だいじょうぶですか = Are you OK?"
  }
 ],
 "examples": [
  {
   "ja": "あたまが いたいです。",
   "romaji": "atama ga itai desu",
   "en": "I have a headache."
  },
  {
   "ja": "ねつが あります。",
   "romaji": "netsu ga arimasu",
   "en": "I have a fever."
  },
  {
   "ja": "くすりを のんでください。",
   "romaji": "kusuri o nonde kudasai",
   "en": "Please take the medicine."
  },
  {
   "ja": "だいじょうぶですか。",
   "romaji": "daijoubu desu ka",
   "en": "Are you all right?"
  }
 ],
 "grammar_note": {
  "title": "〜が いたい / 〜が あります",
  "body": "Body part + が + いたいです expresses pain. Symptoms like ねつ/かぜ use あります / ひきます."
 },
