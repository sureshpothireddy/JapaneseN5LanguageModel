{
 "id": "want_desire",
 "order": 19,
 "title": "Wants & Wishes (〜たい)",
 "icon": "🌟",
 "level": "N5",
 "difficulty": 3,
 "description": "Say what you want to do and what you want with 〜たい and ほしい.",
 "objectives": [
  "Form 〜たいです (want to do)",
  "Use ほしい (want a thing)",
  "Invite with 〜ませんか"
 ],
 "study_guide": [
  {
   "heading": "〜たいです = want to do",
   "body": "Drop ます, add たいです: たべます → たべたいです (want to eat). にほんへ いきたいです = I want to go to Japan."
  },
  {
   "heading": "ほしい = want a thing",
   "body": "For wanting an object, use ほしい: あたらしい くるまが ほしいです = I want a new car. The wanted thing takes が."
  },
  {
   "heading": "Inviting: 〜ませんか",
   "body": "いっしょに いきませんか = Won't you go together (with me)? A polite, warm invitation pattern."
  }
 ],
 "examples": [
  {
   "ja": "にほんへ いきたいです。",
   "romaji": "nihon e ikitai desu",
   "en": "I want to go to Japan."
  },
  {
   "ja": "みずが のみたいです。",
   "romaji": "mizu ga nomitai desu",
   "en": "I want to drink water."
  },
  {
   "ja": "いっしょに たべませんか。",
   "romaji": "issho ni tabemasen ka",
   "en": "Shall we eat together?"
  },
  {
   "ja": "やすみが ほしいです。",
   "romaji": "yasumi ga hoshii desu",
   "en": "I want a day off."
  }
 ],
 "grammar_note": {
  "title": "〜たい / ほしい / ませんか",
  "body": "Verb stem + たいです = want to (verb). Noun + が ほしいです = want (noun). 〜ませんか invites."
 },
 "culture_note": "Directly saying 'I want' can feel strong; Japanese softens it with ね or context. With friends it's fine — politeness scales with the relationship.",
