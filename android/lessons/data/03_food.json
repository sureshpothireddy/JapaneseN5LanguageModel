 "study_guide": [
  {
   "heading": "を marks what you eat/drink",
   "body": "を (pronounced 'o') marks the object: すしを たべます = I eat sushi. The verb always comes last."
  },
  {
   "heading": "Ordering food",
   "body": "[item] を ください = please give me [item]. みずを ください = water please. Polite and perfect for restaurants."
  },
  {
   "heading": "Eat vs drink",
   "body": "たべます = eat (solids), のみます = drink (liquids). おちゃを のみます = I drink tea."
  }
 ],
