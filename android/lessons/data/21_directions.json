 "description": "Find your way: left, right, straight, and 'how do I get to ~?'.",
 "objectives": [
  "Use みぎ/ひだり/まっすぐ",
  "Ask 〜へ どう いきますか",
  "Understand simple directions"
 ],
 "study_guide": [
  {
   "heading": "Core direction words",
   "body": "みぎ = right, ひだり = left, まっすぐ = straight, つぎ = next. みぎに まがってください = please turn right."
  },
  {
   "heading": "Asking the way",
   "body": "えきへ どう いきますか = How do I get to the station? すみません for 'excuse me' opens the question politely."
  },
  {
   "heading": "Landmarks",
   "body": "かど = corner, しんごう = traffic light, こうさてん = intersection. つぎの かどを ひだりに = left at the next corner."
  }
 ],
 "examples": [
  {
   "ja": "えきへ どう いきますか。",
   "romaji": "eki e dou ikimasu ka",
   "en": "How do I get to the station?"
  },
  {
   "ja": "まっすぐ いってください。",
   "romaji": "massugu itte kudasai",
   "en": "Please go straight."
  },
  {
   "ja": "つぎの しんごうを みぎに。",
   "romaji": "tsugi no shingou o migi ni",
   "en": "Right at the next light."
  },
  {
   "ja": "ここから とおいですか。",
   "romaji": "koko kara tooi desu ka",
   "en": "Is it far from here?"
  }
 ],
 "grammar_note": {
  "title": "Directions + に まがる",
  "body": "Direction + に + まがってください = turn (direction). から = from, まで = until/to. へ marks the goal of movement."
 },
 "culture_note": "People in Japan will often walk you partway to your destination rather than just point. Kobans (police boxes, こうばん) are great for directions too.",
