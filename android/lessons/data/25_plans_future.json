  "Suggest with 〜ましょう (let's)",
  "Use つもり (intend to)",
  "Talk about tomorrow/next week"
 ],
 "study_guide": [
  {
   "heading": "〜ましょう = let's",
   "body": "いきましょう = let's go. たべましょう = let's eat. A warm, inclusive suggestion. 〜ましょうか offers ('shall I/we?')."
  },
  {
   "heading": "Plans with つもり",
   "body": "あした べんきょうする つもりです = I intend to study tomorrow. つもり expresses intention."
  },
  {
   "heading": "Future time words",
   "body": "あした (tomorrow), らいしゅう (next week), らいげつ (next month), らいねん (next year)."
  }
 ],
 "examples": [
  {
   "ja": "いっしょに いきましょう。",
   "romaji": "issho ni ikimashou",
   "en": "Let's go together."
  },
  {
   "ja": "あした なにを しますか。",
   "romaji": "ashita nani o shimasu ka",
   "en": "What will you do tomorrow?"
  },
  {
   "ja": "らいしゅう りょこうする つもりです。",
   "romaji": "raishuu ryokou suru tsumori desu",
   "en": "I plan to travel next week."
  },
  {
   "ja": "てつだいましょうか。",
   "romaji": "tetsudaimashou ka",
   "en": "Shall I help you?"
  }
 ],
 "grammar_note": {
  "title": "〜ましょう / つもり",
  "body": "Verb stem + ましょう = let's; + ましょうか = shall we/I. Dictionary verb + つもりです = intend to. Future uses present tense + time word."
 },
