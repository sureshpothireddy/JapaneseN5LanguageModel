 "description": "Talk about the weather and the four seasons.",
 "objectives": [
  "Describe weather with い-adjectives",
  "Name the four seasons",
  "Use 〜ね for agreement"
 ],
 "study_guide": [
  {
   "heading": "Weather basics",
   "body": "てんき = weather. いい てんき = good weather. あめ = rain, ゆき = snow, はれ = clear, くもり = cloudy. きょうは あめです = It's rainy today."
  },
  {
   "heading": "The four seasons",
   "body": "はる (spring), なつ (summer), あき (autumn), ふゆ (winter). なつは あついです = Summer is hot."
  },
  {
   "heading": "〜ね for shared feeling",
   "body": "End with ね to invite agreement: いい てんきですね = Nice weather, isn't it? It's friendly and very common."
  }
 ],
 "examples": [
  {
   "ja": "きょうは あめです。",
   "romaji": "kyou wa ame desu",
   "en": "It's raining today."
  },
  {
   "ja": "なつは とても あついです。",
   "romaji": "natsu wa totemo atsui desu",
   "en": "Summer is very hot."
  },
  {
   "ja": "はるは あたたかいですね。",
   "romaji": "haru wa atatakai desu ne",
   "en": "Spring is warm, isn't it."
  },
  {
   "ja": "ふゆは ゆきが ふります。",
   "romaji": "fuyu wa yuki ga furimasu",
   "en": "In winter it snows."
  }
 ],
 "grammar_note": {
  "title": "Weather + ね",
  "body": "Weather nouns + です describe conditions. とても = very. ね seeks agreement and softens the statement."
 },
