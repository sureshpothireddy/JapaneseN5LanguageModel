 "title": "Self-Introduction",
 "icon": "🙋",
 "level": "N5",
 "difficulty": 1,
 "description": "Introduce yourself: name, country, and 'I am ___'.",
 "objectives": [
  "Use the X は Y です sentence pattern",
  "Say your name and where you're from",
  "Ask someone's name politely"
 ],
 "study_guide": [
  {
   "heading": "The most important pattern: X は Y です",
   "body": "Japanese sentences often follow [topic] は [info] です. は here is a particle pronounced 'wa' (not 'ha'). です (desu) is a polite 'is/am/are'. わたしは リサです = I am Lisa. Literally: 'As for me, Lisa is.'"
  },
  {
   "heading": "Particle は = 'as for'",
   "body": "は marks the topic — the thing you're talking about. わたしは… = 'as for me…'. You'll see this particle everywhere; mastering it now makes everything later easier."
  },
  {
   "heading": "Asking back",
   "body": "Add か to make a question: おなまえは なんですか = What is your name? No question mark needed in Japanese — か does that job."
  }
 ],
 "examples": [
  {
   "ja": "わたしは がくせいです。",
   "romaji": "watashi wa gakusei desu",
   "en": "I am a student."
  },
  {
   "ja": "わたしは アメリカじんです。",
   "romaji": "watashi wa amerika-jin desu",
   "en": "I am American."
  },
  {
   "ja": "おなまえは なんですか。",
   "romaji": "o-namae wa nan desu ka",
   "en": "What is your name?"
  },
  {
   "ja": "どうぞ よろしく。",
   "romaji": "douzo yoroshiku",
   "en": "Pleased to meet you."
  }
 ],
 "grammar_note": {
  "title": "は (wa) and です",
  "body": "は marks the topic and is read 'wa'. です makes the sentence polite. To ask, append か. To say 'is not', です becomes じゃ ありません (covered later)."
 },
 "culture_note": "When introducing yourself, end with どうぞ よろしく おねがいします and a bow. It roughly means 'please be kind to me' — there's no English equivalent, but it's essential social glue.",
