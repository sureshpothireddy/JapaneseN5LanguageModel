 "study_guide": [
  {
   "heading": "Asking where",
   "body": "[place] は どこですか = Where is [place]? えきは どこですか = Where is the station? トイレは どこですか is the traveler's lifesaver."
  },
  {
   "heading": "Going places",
   "body": "[place] に/へ いきます = go to [place]. とうきょうに いきます = I go to Tokyo. に and へ both mark destination."
  },
  {
   "heading": "By what means",
   "body": "[transport] で いきます = go by [transport]. でんしゃで いきます = I go by train. で marks the method."
  }
 ],
