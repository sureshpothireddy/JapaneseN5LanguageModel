{
 "id": "can_dekiru",
 "order": 23,
 "title": "Ability (できます)",
 "icon": "💪",
 "level": "N5",
 "difficulty": 3,
 "description": "Say what you can and can't do with できます and counters of skill.",
 "objectives": [
  "Use 〜が できます (can do)",
  "Say noun + が できます",
  "Combine with frequency words"
 ],
 "study_guide": [
  {
   "heading": "〜が できます",
   "body": "できます = can do / is possible. にほんごが できます = I can speak Japanese. The ability's object takes が."
  },
  {
   "heading": "Activity + が できます",
   "body": "うんてんが できます = I can drive. りょうりが できます = I can cook. Pair a noun-activity with が できます."
  },
  {
   "heading": "Frequency words",
   "body": "いつも (always), よく (often), ときどき (sometimes), あまり (not much), ぜんぜん (not at all) add nuance to ability/habit."
  }
 ],
 "examples": [
  {
   "ja": "にほんごが すこし できます。",
   "romaji": "nihongo ga sukoshi dekimasu",
   "en": "I can speak a little Japanese."
  },
  {
   "ja": "うんてんが できますか。",
   "romaji": "unten ga dekimasu ka",
   "en": "Can you drive?"
  },
  {
   "ja": "よく りょうりを します。",
   "romaji": "yoku ryouri o shimasu",
   "en": "I often cook."
  },
  {
   "ja": "ぜんぜん およげません。",
   "romaji": "zenzen oyogemasen",
   "en": "I can't swim at all."
  }
 ],
 "grammar_note": {
  "title": "〜が できます + frequency",
  "body": "Noun + が できます = able to do. Negative できません. Frequency adverbs (いつも/よく/ときどき/あまり/ぜんぜん) modify verbs."
 },
 "culture_note": "Modesty is valued: even fluent speakers often say にほんごが すこし できます ('a little'). Downplaying ability is polite, not dishonest.",
