{
 "id": "te_imasu",
 "order": 18,
 "title": "Now Happening (ています)",
 "icon": "📲",
 "level": "N5",
 "difficulty": 3,
 "description": "Describe actions in progress and ongoing states with ています.",
 "objectives": [
  "Form 〜ています for ongoing actions",
  "Describe states (married, living in ~)",
  "Answer なにを していますか"
 ],
 "study_guide": [
  {
   "heading": "〜ています = -ing",
   "body": "て-form + います = action in progress: たべています = (I) am eating. いま なにを していますか = What are you doing now?"
  },
  {
   "heading": "Ongoing states",
   "body": "Some verbs become states: とうきょうに すんでいます = I live in Tokyo. けっこんしています = I'm married. しっています = I know."
  },
  {
   "heading": "Talking about jobs",
   "body": "ぎんこうで はたらいています = I work at a bank. で marks where an action happens."
  }
 ],
 "examples": [
  {
   "ja": "いま ごはんを たべています。",
   "romaji": "ima gohan o tabete imasu",
   "en": "I'm eating now."
  },
  {
   "ja": "とうきょうに すんでいます。",
   "romaji": "toukyou ni sunde imasu",
   "en": "I live in Tokyo."
  },
  {
   "ja": "かいしゃで はたらいています。",
   "romaji": "kaisha de hataraite imasu",
   "en": "I work at a company."
  },
  {
   "ja": "なにを していますか。",
   "romaji": "nani o shite imasu ka",
   "en": "What are you doing?"
  }
 ],
 "grammar_note": {
  "title": "て-form + います",
  "body": "Expresses ongoing action or resulting state. で marks the place of an action; に marks the place of residence/existence."
 },
