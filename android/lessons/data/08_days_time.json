 "description": "Tell the time, name the days of the week, and say 'when'.",
 "objectives": [
  "Read clock times with じ (o'clock) and ふん (minutes)",
  "Name the seven days of the week",
  "Ask なんじですか (what time is it?)"
 ],
 "study_guide": [
  {
   "heading": "Telling the hour: 〜じ",
   "body": "Add じ to a number for the hour: いちじ = 1 o'clock, さんじ = 3 o'clock. Watch the irregulars: 4 o'clock is よじ (not よんじ), 7 is しちじ, 9 is くじ."
  },
  {
   "heading": "Minutes: 〜ふん / 〜ぷん",
   "body": "Minutes use ふん or ぷん depending on the number: ごふん = 5 min, じゅっぷん = 10 min. ごぜん = AM, ごご = PM. ごご さんじ = 3 PM."
  },
  {
   "heading": "Days of the week",
   "body": "Each day ends in ようび: げつようび (Mon), かようび (Tue), すいようび (Wed), もくようび (Thu), きんようび (Fri), どようび (Sat), にちようび (Sun)."
  }
 ],
 "examples": [
  {
   "ja": "いま なんじですか。",
   "romaji": "ima nan-ji desu ka",
   "en": "What time is it now?"
  },
  {
   "ja": "ごご さんじです。",
   "romaji": "gogo san-ji desu",
   "en": "It's 3 PM."
  },
  {
   "ja": "きょうは げつようびです。",
   "romaji": "kyou wa getsu-youbi desu",
   "en": "Today is Monday."
  },
  {
   "ja": "しけんは きんようびです。",
   "romaji": "shiken wa kin-youbi desu",
   "en": "The exam is on Friday."
  }
 ],
 "grammar_note": {
  "title": "Time expressions",
  "body": "Hour = number + じ (irregulars: 4=よ, 7=しち, 9=く). Minutes = number + ふん/ぷん. ごぜん=AM, ごご=PM. Days end in ようび."
 },
 "culture_note": "Japanese trains and shops run on precise time. A meeting at さんじ means 3:00 sharp — arriving 'on time' culturally means arriving a few minutes early.",
