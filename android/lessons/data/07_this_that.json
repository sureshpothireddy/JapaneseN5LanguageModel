{
 "id": "this_that",
 "order": 7,
 "title": "This & That (これ・それ・あれ)",
 "icon": "👉",
 "level": "N5",
 "difficulty": 1,
 "description": "Point at things and name them with これ, それ, あれ.",
 "objectives": [
  "Distinguish これ / それ / あれ by distance",
  "Ask 'what is this?' これは なんですか",
  "Use の to connect nouns (this is my book)"
 ],
 "study_guide": [
  {
   "heading": "Three distances",
   "body": "これ = this (near me). それ = that (near you). あれ = that over there (far from both). The ko-so-a-do system runs through all of Japanese — learn it once, reuse forever."
  },
  {
   "heading": "これは なんですか",
   "body": "これは なんですか = What is this? Answer: それは ほんです = That (by you) is a book. Notice the speaker switches これ→それ depending on who's closer."
  },
  {
   "heading": "の joins nouns",
   "body": "の links two nouns, usually showing possession or type: わたしの ほん = my book, にほんごの ほん = a Japanese-language book."
  }
 ],
 "examples": [
  {
   "ja": "これは ほんです。",
   "romaji": "kore wa hon desu",
   "en": "This is a book."
  },
  {
   "ja": "それは なんですか。",
   "romaji": "sore wa nan desu ka",
   "en": "What is that?"
  },
  {
   "ja": "あれは わたしの かばんです。",
   "romaji": "are wa watashi no kaban desu",
   "en": "That over there is my bag."
  },
  {
   "ja": "これは にほんごの ほんです。",
   "romaji": "kore wa nihongo no hon desu",
   "en": "This is a Japanese book."
  }
 ],
 "grammar_note": {
  "title": "これ・それ・あれ + の",
  "body": "これ/それ/あれ are 'this/that/that-yonder'. Pair them with は…です to identify things. の connects nouns: A の B means 'B of A' or 'A's B'."
 },
 "culture_note": "Pointing with one finger is a little blunt in Japan; people often gesture with an open hand. But これ/それ/あれ in speech do the pointing for you.",
