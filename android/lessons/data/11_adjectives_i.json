{
 "id": "adjectives_i",
 "order": 11,
 "title": "い-Adjectives",
 "icon": "🌶️",
 "level": "N5",
 "difficulty": 2,
 "description": "Describe things: big, small, hot, delicious — with い-adjectives.",
 "objectives": [
  "Use い-adjectives before nouns and with です",
  "Negate い-adjectives (〜くない)",
  "Combine adjective + noun"
 ],
 "study_guide": [
  {
   "heading": "い-adjectives end in い",
   "body": "おおきい (big), ちいさい (small), あつい (hot), さむい (cold), たかい (expensive/tall). Put them straight before a noun: おおきい いえ = a big house."
  },
  {
   "heading": "With です",
   "body": "このいえは おおきいです = This house is big. Keep the い; just add です for politeness. Don't add な."
  },
  {
   "heading": "Negative: 〜くない",
   "body": "Drop い, add くない: たかい → たかくない (not expensive). Polite: たかくないです or たかく ありません."
  }
 ],
 "examples": [
  {
   "ja": "このカメラは たかいです。",
   "romaji": "kono kamera wa takai desu",
   "en": "This camera is expensive."
  },
  {
   "ja": "あたらしい くるまですね。",
   "romaji": "atarashii kuruma desu ne",
   "en": "That's a new car, isn't it."
  },
  {
   "ja": "きょうは さむくないです。",
   "romaji": "kyou wa samukunai desu",
   "en": "Today isn't cold."
  },
  {
   "ja": "おおきい いぬが すきです。",
   "romaji": "ookii inu ga suki desu",
   "en": "I like big dogs."
  }
 ],
 "grammar_note": {
  "title": "い-adjective conjugation",
  "body": "Attributive: adj + noun. Predicate: adj + です. Negative: drop い + くないです. Past comes later (〜かったです)."
 },
